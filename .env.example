# TraceTest AI — Example Environment Configuration
# Copy this file to .env and adjust variables as needed for your local setup.
# Never commit real credentials to git. File permissions should be set to 0600.

# ------------------------------------------------------------------------------
# Core Environment & Storage
# ------------------------------------------------------------------------------
TRACETEST_ENV=development
TRACETEST_DATA_DIR=./var
# In production, specify a 64+ char random hex key. In development, auto-generated in var/.secret_key if omitted.
TRACETEST_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
TRACETEST_SESSION_HOURS=12
TRACETEST_COOKIE_SECURE=false
TRACETEST_CORS_ORIGINS=http://localhost:5173
TRACETEST_HOST=127.0.0.1
TRACETEST_PORT=8000
TRACETEST_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
TRACETEST_REQUIRE_NETWORK_ISOLATION=true
TRACETEST_ALLOW_WEAK_SANDBOX=false
TRACETEST_SEED_ON_STARTUP=false
TRACETEST_RATE_LIMIT_PER_MINUTE=600
TRACETEST_SINGLE_OPERATOR=true

# ------------------------------------------------------------------------------
# Persona Email Identifiers (Credentials auto-generated in var/initial_credentials.txt)
# ------------------------------------------------------------------------------
TRACETEST_DEV_EMAIL=dev@dayforce-qa.local
TRACETEST_ADMIN_EMAIL=admin@dayforce-qa.local
TRACETEST_QA_EMAIL=qa.engineer@dayforce-qa.local
TRACETEST_REVIEWER_EMAIL=reviewer@dayforce-qa.local

# ------------------------------------------------------------------------------
# AI Provider Configuration & Key Pools
# Modes: live (real API calls) | mock (deterministic fixture test mode)
# ------------------------------------------------------------------------------
TRACETEST_LLM_MODE=live
TRACETEST_PRIMARY_PROVIDER=groq
TRACETEST_JUDGE_PROVIDER=gemini
TRACETEST_JUDGE_MODEL=gemini-2.5-flash

# Groq Key Pool (Slots 1, 2, 3) & Model Settings
GROQ_API_KEY=your-groq-key-slot-1-here
GROQ_API_KEY2=your-groq-key-slot-2-here
GROQ_API_KEY3=your-groq-key-slot-3-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CONCURRENCY_PER_SLOT=2

# Google Gemini Key Pool (Slots 1, 2, 3) & Model Settings (Primary Provider)
GEMINI_API_KEY=your-gemini-key-slot-1-here
GEMINI_API_KEY2=your-gemini-key-slot-2-here
GEMINI_API_KEY3=your-gemini-key-slot-3-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Local Ollama (Optional)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# AI Timeouts & Retries
TRACETEST_LLM_TIMEOUT=60.0
TRACETEST_LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Execution Sandbox Constraints
# ------------------------------------------------------------------------------
TRACETEST_EXEC_TIMEOUT=60
TRACETEST_EXEC_MEMORY_MB=512
TRACETEST_EXEC_MAX_OUTPUT=256000
TRACETEST_PLAYWRIGHT_TARGET_URL=
TRACETEST_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# ------------------------------------------------------------------------------
# Integrations (Optional)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your-github-pat-here
GITHUB_API_URL=https://api.github.com
TRACETEST_CI_TOKEN=your-ci-report-token-here
TRACETEST_URL=http://127.0.0.1:8000
